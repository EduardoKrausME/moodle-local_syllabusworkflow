<section class="local-syllabusworkflow-reports">
    <h2>{{labelpending}}</h2>
    <table class="generaltable"><tbody>{{#pending}}<tr><td><a href="{{{url}}}">{{courseid}}</a></td><td>{{revision}}</td>
        <td>{{status}}</td><td>{{date}}</td></tr>{{/pending}}</tbody></table>
    <h2>{{labelapproved}}</h2>
    <table class="generaltable"><tbody>{{#approved}}<tr><td><a href="{{{url}}}">{{courseid}}</a></td><td>{{revision}}</td>
        <td>{{status}}</td><td>{{date}}</td></tr>{{/approved}}</tbody></table>
</section>
