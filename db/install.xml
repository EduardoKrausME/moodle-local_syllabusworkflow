<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/syllabusworkflow/db" VERSION="20261014" COMMENT="Syllabus approval workflow schema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="local_swf_template" COMMENT="Institutional template identity">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="activeversionid" TYPE="int" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="enabled" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/></KEYS>
    </TABLE>
    <TABLE NAME="local_swf_tplversion" COMMENT="Immutable institutional template revisions">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="templateid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="revision" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="schemajson" TYPE="text" NOTNULL="true"/>
        <FIELD NAME="workflowjson" TYPE="text" NOTNULL="true"/>
        <FIELD NAME="identityjson" TYPE="text" NOTNULL="true"/>
        <FIELD NAME="contenthash" TYPE="char" LENGTH="64" NOTNULL="true"/>
        <FIELD NAME="createdby" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/><KEY NAME="templatefk" TYPE="foreign" FIELDS="templateid" REFTABLE="local_swf_template" REFFIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="templrev" UNIQUE="true" FIELDS="templateid, revision"/></INDEXES>
    </TABLE>
    <TABLE NAME="local_swf_plan" COMMENT="Stable plan and currently published version pointers">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="templateversionid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="currentversionid" TYPE="int" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="publishedversionid" TYPE="int" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="createdby" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/><KEY NAME="coursefk" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/><KEY NAME="templateversionfk" TYPE="foreign" FIELDS="templateversionid" REFTABLE="local_swf_tplversion" REFFIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="course" UNIQUE="false" FIELDS="courseid"/></INDEXES>
    </TABLE>
    <TABLE NAME="local_swf_version" COMMENT="Full immutable submitted/approved revisions and mutable drafts">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="planid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="revision" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="parentid" TYPE="int" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="templateversionid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="payload" TYPE="text" NOTNULL="true"/>
        <FIELD NAME="snapshot" TYPE="text" NOTNULL="true"/>
        <FIELD NAME="contenthash" TYPE="char" LENGTH="64" NOTNULL="true"/>
        <FIELD NAME="status" TYPE="char" LENGTH="32" NOTNULL="true"/>
        <FIELD NAME="lockversion" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="createdby" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/><KEY NAME="planfk" TYPE="foreign" FIELDS="planid" REFTABLE="local_swf_plan" REFFIELDS="id"/><KEY NAME="versiontemplatefk" TYPE="foreign" FIELDS="templateversionid" REFTABLE="local_swf_tplversion" REFFIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="planrev" UNIQUE="true" FIELDS="planid, revision"/><INDEX NAME="status" UNIQUE="false" FIELDS="status"/></INDEXES>
    </TABLE>
    <TABLE NAME="local_swf_assignment" COMMENT="Review assignments by workflow stage">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="versionid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="stage" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="reviewerid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="duedate" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true"/>
        <FIELD NAME="assignedby" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/><KEY NAME="versionfk" TYPE="foreign" FIELDS="versionid" REFTABLE="local_swf_version" REFFIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="reviewerstatus" UNIQUE="false" FIELDS="reviewerid, status"/><INDEX NAME="assignment" UNIQUE="true" FIELDS="versionid, stage, reviewerid"/></INDEXES>
    </TABLE>
    <TABLE NAME="local_swf_approval" COMMENT="Immutable reviewer decisions">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="versionid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="stage" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="reviewerid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="decision" TYPE="char" LENGTH="20" NOTNULL="true"/>
        <FIELD NAME="comment" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/><KEY NAME="versionfk" TYPE="foreign" FIELDS="versionid" REFTABLE="local_swf_version" REFFIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="versionstage" UNIQUE="false" FIELDS="versionid, stage"/></INDEXES>
    </TABLE>
    <TABLE NAME="local_swf_transition" COMMENT="Append-only state transition log">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="versionid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="fromstate" TYPE="char" LENGTH="32" NOTNULL="true"/>
        <FIELD NAME="tostate" TYPE="char" LENGTH="32" NOTNULL="true"/>
        <FIELD NAME="actorid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="comment" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="operationid" TYPE="char" LENGTH="64" NOTNULL="true"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/><KEY NAME="versionfk" TYPE="foreign" FIELDS="versionid" REFTABLE="local_swf_version" REFFIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="operationid" UNIQUE="true" FIELDS="operationid"/><INDEX NAME="history" UNIQUE="false" FIELDS="versionid, timecreated"/></INDEXES>
    </TABLE>
    <TABLE NAME="local_swf_publication" COMMENT="Append-only publication history">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="planid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="versionid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="actorid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/><KEY NAME="planfk" TYPE="foreign" FIELDS="planid" REFTABLE="local_swf_plan" REFFIELDS="id"/><KEY NAME="versionfk" TYPE="foreign" FIELDS="versionid" REFTABLE="local_swf_version" REFFIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="plancreated" UNIQUE="false" FIELDS="planid, timecreated"/></INDEXES>
    </TABLE>
    <TABLE NAME="local_swf_notice" COMMENT="Message deduplication / sending ledger">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="versionid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="recipientid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="kind" TYPE="char" LENGTH="32" NOTNULL="true"/>
        <FIELD NAME="dedupekey" TYPE="char" LENGTH="64" NOTNULL="true"/>
        <FIELD NAME="timesent" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/><KEY NAME="versionfk" TYPE="foreign" FIELDS="versionid" REFTABLE="local_swf_version" REFFIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="dedupe" UNIQUE="true" FIELDS="dedupekey"/></INDEXES>
    </TABLE>
    <TABLE NAME="local_swf_audit" COMMENT="Append-only record of edits and delegations">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="versionid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="action" TYPE="char" LENGTH="64" NOTNULL="true"/>
        <FIELD NAME="actorid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="comment" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="operationid" TYPE="char" LENGTH="64" NOTNULL="true"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/><KEY NAME="versionfk" TYPE="foreign" FIELDS="versionid" REFTABLE="local_swf_version" REFFIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="operation" UNIQUE="true" FIELDS="operationid"/><INDEX NAME="version" UNIQUE="false" FIELDS="versionid"/></INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
